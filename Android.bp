soong_namespace {
    imports: [
        "hardware/xiaomi",
        "hardware/mediatek",
        "hardware/google/pixel",
    ]
}
cc_library_shared {
    name: "libldacBT_bco",
}

prebuilt_hidl_interfaces {
    name: "hidl_supplicant_interface",
    interfaces: [
        "vendor.mediatek.hardware.wifi.supplicant@2.0::ISupplicant",
    ],
}

prebuilt_hidl_interfaces { 
    name: "hidl_atci_interface",
    interfaces: [  
        "vendor.mediatek.hardware.atci@1.0::IAtcid",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_mtkcodecservice_interface",
    interfaces: [
        "vendor.mediatek.hardware.mtkcodecservice@1.1::IMtkCodecService",
    ],
}

prebuilt_hidl_interfaces { 
    name: "hidl_mms_interface",
    interfaces: [  
        "vendor.mediatek.hardware.mms@1.0::IMms",
        "vendor.mediatek.hardware.mms@1.1::IMms",
        "vendor.mediatek.hardware.mms@1.2::IMms",
        "vendor.mediatek.hardware.mms@1.3::IMms",
        "vendor.mediatek.hardware.mms@1.4::IMms",
        "vendor.mediatek.hardware.mms@1.5::IMms",
    ],
}
